# ──────────────────────────────
# DATABASE (Railway provê automaticamente via variável de ambiente)
# ──────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# ──────────────────────────────
# NEXTAUTH / AUTH.JS
# Gere com: npx auth secret
# ──────────────────────────────
AUTH_SECRET="sua-chave-secreta-de-pelo-menos-32-caracteres"

# ──────────────────────────────
# UPLOADTHING
# Obtenha em: https://uploadthing.com → Dashboard → App Keys
# ──────────────────────────────
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxxxxxxxxxx"

# ──────────────────────────────
# URL DA APLICAÇÃO (obrigatório em produção — Auth.js v5 usa AUTH_URL)
# Cole aqui a URL pública gerada pelo Railway (ex: https://xyz.railway.app)
# ──────────────────────────────
AUTH_URL="https://seu-app.railway.app"

# ──────────────────────────────
# WEB PUSH (VAPID)
# Gere com: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(JSON.stringify(k))"
# ──────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="sua-vapid-public-key"
VAPID_PRIVATE_KEY="sua-vapid-private-key"
VAPID_SUBJECT="mailto:admin@seu-dominio.com"

# ──────────────────────────────
# E-MAIL (SMTP) — alertas de novo conteúdo, chat emergencial e solicitações
# Ex. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 + "senha de app" em SMTP_PASS
# Sem SMTP_HOST os e-mails NÃO são enviados (apenas registrados no log)
# ──────────────────────────────
SMTP_HOST="smtp.seu-provedor.com"
SMTP_PORT="587"
SMTP_USER="intranet@seu-dominio.com"
SMTP_PASS="sua-senha-smtp"
SMTP_FROM="Intranet Companhia do Churrasco <intranet@seu-dominio.com>"
