# ──────────────────────────────
# DATABASE (Railway provê automaticamente via variável de ambiente)
# ──────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# ──────────────────────────────
# NEXTAUTH / AUTH.JS
# Gere com: npx auth secret
# ──────────────────────────────
AUTH_SECRET="sua-chave-secreta-de-pelo-menos-32-caracteres"

# ──────────────────────────────
# UPLOADTHING
# Obtenha em: https://uploadthing.com → Dashboard → App Keys
# ──────────────────────────────
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxxxxxxxxxx"

# ──────────────────────────────
# URL DA APLICAÇÃO (obrigatório em produção — Auth.js v5 usa AUTH_URL)
# Cole aqui a URL pública gerada pelo Railway (ex: https://xyz.railway.app)
# ──────────────────────────────
AUTH_URL="https://seu-app.railway.app"
