generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FRANCHISEE
  MANAGER
}

enum FileType {
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  OTHER
  NOTICE
}

enum OnboardingPhase {
  OBRAS
  EQUIPAMENTOS
  TREINAMENTO
  APROVACAO
}

enum RequestStatus {
  PENDING
  SEEN
  IN_PROGRESS
  DONE
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  password          String
  role              Role                 @default(FRANCHISEE)
  phone             String?
  active            Boolean              @default(true)
  createdById       String?
  createdBy         User?                @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]               @relation("CreatedUsers")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  materials         Material[]
  stores            UserStore[]
  conversations     Conversation[]       @relation("FranchiseeConversations")
  adminConversations Conversation[]      @relation("AdminConversations")
  sentMessages      Message[]            @relation("SentMessages")
  materialViews     MaterialView[]
  pushSubscriptions PushSubscription[]
  surveyResponses   SurveyResponse[]
  tutorialSeen      AppTutorialSeen?
  comunicados       Comunicado[]
  comunicadoViews   ComunicadoView[]
  alertViews        AlertView[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?    @default("📁")
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Material {
  id                String             @id @default(cuid())
  title             String
  description       String?
  fileUrl           String?
  fileKey           String?
  fileType          FileType           @default(OTHER)
  mimeType          String?
  fileSize          Int?
  published         Boolean            @default(true)
  // Cor de destaque do card (ex.: "amber", "blue"); null = padrão
  color             String?
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  views             MaterialView[]
  linkedStores      MaterialStore[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// ── Lojas ───────────────────────────────────────────────────────────────
model Store {
  id             String               @id @default(cuid())
  name           String
  code           String               @unique
  city           String?
  lat            Float?
  lng            Float?
  active         Boolean              @default(true)
  users          UserStore[]
  alerts         NonComplianceAlert[]
  onboarding     StoreOnboarding?
  messageLinks   MessageStore[]
  materialLinks  MaterialStore[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model UserStore {
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model MaterialStore {
  materialId String
  storeId    String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([materialId, storeId])
}

// ── Chat ────────────────────────────────────────────────────────────────
model Conversation {
  id           String    @id @default(cuid())
  // Participante não-admin (franqueado ou gerente)
  franchiseeId String
  franchisee   User      @relation("FranchiseeConversations", fields: [franchiseeId], references: [id], onDelete: Cascade)
  // Admin dono da conversa; null = conversa legada (unificada)
  adminId      String?
  admin        User?     @relation("AdminConversations", fields: [adminId], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([franchiseeId, adminId])
}

model Message {
  id               String         @id @default(cuid())
  conversationId   String
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content          String?
  fileUrl          String?
  fileKey          String?
  fileType         String?
  fileName         String?
  category            String?
  requestStatus       RequestStatus?
  // Agrupa as cópias de uma mesma solicitação enviada a vários admins
  requestGroupId      String?
  seenAt              DateTime?
  inProgressAt        DateTime?
  doneAt              DateTime?
  adminReplyContent   String?
  adminReplyFileUrl   String?
  adminReplyFileKey   String?
  adminReplyFileName  String?
  adminReplyFileType  String?
  readByAdmin         Boolean        @default(false)
  readByFranchisee    Boolean        @default(false)
  linkedStores        MessageStore[]
  createdAt           DateTime       @default(now())

  @@index([requestGroupId])
}

model MessageStore {
  messageId String
  storeId   String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([messageId, storeId])
}

// ── Visualizações de materiais ──────────────────────────────────────────
model MaterialView {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())

  @@unique([userId, materialId])
}

// ── Push Notifications ──────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ── Registros (antigas Não Conformidades) ───────────────────────────────
model NonComplianceAlert {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  description String
  fileUrl     String?
  fileKey     String?
  fileName    String?
  fileType    String?
  views       AlertView[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Registro de quem visualizou cada Registro
model AlertView {
  id       String             @id @default(cuid())
  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId  String
  alert    NonComplianceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  viewedAt DateTime           @default(now())

  @@unique([userId, alertId])
}

// ── Comunicados (aviso geral admin → rede) ──────────────────────────────
model Comunicado {
  id          String           @id @default(cuid())
  title       String
  body        String
  fileUrl     String?
  fileKey     String?
  fileName    String?
  fileType    String?
  published   Boolean          @default(true)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  views       ComunicadoView[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ComunicadoView {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comunicadoId String
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  viewedAt     DateTime   @default(now())

  @@unique([userId, comunicadoId])
}

// ── Pesquisas Rápidas ───────────────────────────────────────────────────
model Survey {
  id        String           @id @default(cuid())
  question  String
  options   SurveyOption[]
  active    Boolean          @default(true)
  endsAt    DateTime?
  responses SurveyResponse[]
  createdAt DateTime         @default(now())
}

model SurveyOption {
  id        String           @id @default(cuid())
  surveyId  String
  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text      String
  order     Int              @default(0)
  responses SurveyResponse[]
}

model SurveyResponse {
  id          String       @id @default(cuid())
  surveyId    String
  survey      Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  optionId    String
  option      SurveyOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  respondedAt DateTime     @default(now())

  @@unique([surveyId, userId])
}

// ── Onboarding de Loja ──────────────────────────────────────────────────
model StoreOnboarding {
  id          String           @id @default(cuid())
  storeId     String           @unique
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  isNewStore  Boolean          @default(true)
  steps       OnboardingStep[]
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model OnboardingStep {
  id           String          @id @default(cuid())
  onboardingId String
  onboarding   StoreOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  phase        OnboardingPhase
  responsible  String?
  order        Int             @default(0)
  completedAt  DateTime?
}

// ── Tutorial visto ──────────────────────────────────────────────────────
model AppTutorialSeen {
  id     String   @id @default(cuid())
  userId String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt DateTime @default(now())
}

