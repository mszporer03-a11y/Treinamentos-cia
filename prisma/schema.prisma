generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FRANCHISEE
  MANAGER
}

enum FileType {
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  OTHER
  NOTICE
}

// ── Novos enums ─────────────────────────────────────────────────────────
enum SupplyStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

enum SupplyCategory {
  INSUMOS
  UNIFORMES
  TALHERES
  DESCARTAVEIS
  OUTROS
}

enum EmployeeRole {
  CHURRASQUEIRO
  AUXILIAR_CHURRASCO
  CAIXA
  GERENTE_OPERACIONAL
  ASG
  OUTRO
}

enum ShiftType {
  MANHA
  TARDE
  NOITE
  INTEGRAL
  FOLGA
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DocCategory {
  CONTRATO
  ADITIVO
  PROCURACAO
  ALVARA
  CERTIFICADO
  OUTRO
}

enum OnboardingPhase {
  OBRAS
  EQUIPAMENTOS
  TREINAMENTO
  APROVACAO
}

enum RequestStatus {
  PENDING
  SEEN
  IN_PROGRESS
  DONE
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  password          String
  role              Role                 @default(FRANCHISEE)
  phone             String?
  active            Boolean              @default(true)
  createdById       String?
  createdBy         User?                @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]               @relation("CreatedUsers")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  materials         Material[]
  stores            UserStore[]
  conversations     Conversation[]       @relation("FranchiseeConversations")
  adminConversations Conversation[]      @relation("AdminConversations")
  sentMessages      Message[]            @relation("SentMessages")
  materialViews     MaterialView[]
  pushSubscriptions PushSubscription[]
  supplyRequests    SupplyRequest[]
  surveyResponses   SurveyResponse[]
  documents         FranchiseeDocument[]
  tutorialSeen      AppTutorialSeen?
  checklistResponses ChecklistResponse[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?    @default("📁")
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Material {
  id                String             @id @default(cuid())
  title             String
  description       String?
  fileUrl           String?
  fileKey           String?
  fileType          FileType           @default(OTHER)
  mimeType          String?
  fileSize          Int?
  published         Boolean            @default(true)
  // Cor de destaque do card (ex.: "amber", "blue"); null = padrão
  color             String?
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  views             MaterialView[]
  employeeTrainings EmployeeTraining[]
  linkedStores      MaterialStore[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// ── Lojas ───────────────────────────────────────────────────────────────
model Store {
  id             String               @id @default(cuid())
  name           String
  code           String               @unique
  city           String?
  lat            Float?
  lng            Float?
  active         Boolean              @default(true)
  users          UserStore[]
  employees      Employee[]
  supplyRequests SupplyRequest[]
  alerts         NonComplianceAlert[]
  schedules      WorkSchedule[]
  kiloPrices     KiloPrice[]
  onboarding     StoreOnboarding?
  messageLinks   MessageStore[]
  materialLinks  MaterialStore[]
  checklistResponses ChecklistResponse[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model UserStore {
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model MaterialStore {
  materialId String
  storeId    String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([materialId, storeId])
}

// ── Chat ────────────────────────────────────────────────────────────────
model Conversation {
  id           String    @id @default(cuid())
  // Participante não-admin (franqueado ou gerente)
  franchiseeId String
  franchisee   User      @relation("FranchiseeConversations", fields: [franchiseeId], references: [id], onDelete: Cascade)
  // Admin dono da conversa; null = conversa legada (unificada)
  adminId      String?
  admin        User?     @relation("AdminConversations", fields: [adminId], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([franchiseeId, adminId])
}

model Message {
  id               String         @id @default(cuid())
  conversationId   String
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content          String?
  fileUrl          String?
  fileKey          String?
  fileType         String?
  fileName         String?
  category            String?
  requestStatus       RequestStatus?
  // Agrupa as cópias de uma mesma solicitação enviada a vários admins
  requestGroupId      String?
  seenAt              DateTime?
  inProgressAt        DateTime?
  doneAt              DateTime?
  adminReplyContent   String?
  adminReplyFileUrl   String?
  adminReplyFileKey   String?
  adminReplyFileName  String?
  adminReplyFileType  String?
  readByAdmin         Boolean        @default(false)
  readByFranchisee    Boolean        @default(false)
  linkedStores        MessageStore[]
  createdAt           DateTime       @default(now())

  @@index([requestGroupId])
}

model MessageStore {
  messageId String
  storeId   String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([messageId, storeId])
}

// ── Visualizações de materiais ──────────────────────────────────────────
model MaterialView {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())

  @@unique([userId, materialId])
}

// ── Push Notifications ──────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ── Pedidos de Insumos ──────────────────────────────────────────────────
model SupplyRequest {
  id          String              @id @default(cuid())
  storeId     String
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User                @relation(fields: [requesterId], references: [id])
  items       SupplyRequestItem[]
  status      SupplyStatus        @default(PENDING)
  notes       String?
  adminNotes  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model SupplyRequestItem {
  id        String        @id @default(cuid())
  requestId String
  request   SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category  SupplyCategory
  name      String
  quantity  Int
  unit      String        @default("un")
}

// ── Funcionários ────────────────────────────────────────────────────────
model Employee {
  id        String             @id @default(cuid())
  storeId   String
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  role      EmployeeRole       @default(OUTRO)
  contact   String?
  active    Boolean            @default(true)
  shifts    WorkShift[]
  trainings EmployeeTraining[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// ── Escala de Trabalho ──────────────────────────────────────────────────
model WorkSchedule {
  id        String      @id @default(cuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  weekStart DateTime
  shifts    WorkShift[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([storeId, weekStart])
}

model WorkShift {
  id         String       @id @default(cuid())
  scheduleId String
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayIndex   Int          // 0=Mon … 6=Sun
  type       ShiftType    @default(MANHA)
  startTime  String?
  endTime    String?

  @@unique([scheduleId, employeeId, dayIndex])
}

// ── Treinamento de Colaboradores ────────────────────────────────────────
model EmployeeTraining {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([employeeId, materialId])
}

// ── Alertas de Não Conformidade ─────────────────────────────────────────
model NonComplianceAlert {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    AlertSeverity @default(MEDIUM)
  status      AlertStatus   @default(OPEN)
  dueDate     DateTime?
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ── Campanhas de Marketing ──────────────────────────────────────────────
model MarketingCampaign {
  id          String          @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  published   Boolean         @default(false)
  assets      CampaignAsset[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CampaignAsset {
  id         String            @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileKey    String
  fileName   String
  fileType   String
  createdAt  DateTime          @default(now())
}

// ── Pesquisas Rápidas ───────────────────────────────────────────────────
model Survey {
  id        String           @id @default(cuid())
  question  String
  options   SurveyOption[]
  active    Boolean          @default(true)
  endsAt    DateTime?
  responses SurveyResponse[]
  createdAt DateTime         @default(now())
}

model SurveyOption {
  id        String           @id @default(cuid())
  surveyId  String
  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text      String
  order     Int              @default(0)
  responses SurveyResponse[]
}

model SurveyResponse {
  id          String       @id @default(cuid())
  surveyId    String
  survey      Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  optionId    String
  option      SurveyOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  respondedAt DateTime     @default(now())

  @@unique([surveyId, userId])
}

// ── Documentos por Franqueado ───────────────────────────────────────────
model FranchiseeDocument {
  id           String      @id @default(cuid())
  franchiseeId String
  franchisee   User        @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  title        String
  category     DocCategory @default(OUTRO)
  fileUrl      String
  fileKey      String
  fileName     String
  expiresAt    DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
}

// ── Preço do Quilo ──────────────────────────────────────────────────────
model KiloPrice {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  price         Float
  suggestedById String?
  suggestedNote String?
  confirmedAt   DateTime?
  effectiveFrom DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

// ── Onboarding de Loja ──────────────────────────────────────────────────
model StoreOnboarding {
  id          String           @id @default(cuid())
  storeId     String           @unique
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  isNewStore  Boolean          @default(true)
  steps       OnboardingStep[]
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model OnboardingStep {
  id           String          @id @default(cuid())
  onboardingId String
  onboarding   StoreOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  phase        OnboardingPhase
  responsible  String?
  order        Int             @default(0)
  completedAt  DateTime?
}

// ── Tutorial visto ──────────────────────────────────────────────────────
model AppTutorialSeen {
  id     String   @id @default(cuid())
  userId String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt DateTime @default(now())
}

// ── Checklists ──────────────────────────────────────────────────────────
model ChecklistTemplate {
  id          String             @id @default(cuid())
  name        String
  description String?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  sections    ChecklistSection[]
  responses   ChecklistResponse[]
}

model ChecklistSection {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int               @default(0)
  items      ChecklistItem[]
}

model ChecklistItem {
  id            String                   @id @default(cuid())
  sectionId     String
  section       ChecklistSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text          String
  order         Int                      @default(0)
  responseItems ChecklistResponseItem[]
}

model ChecklistResponse {
  id          String                   @id @default(cuid())
  templateId  String
  template    ChecklistTemplate        @relation(fields: [templateId], references: [id])
  storeId     String
  store       Store                    @relation(fields: [storeId], references: [id])
  responderId String
  responder   User                     @relation(fields: [responderId], references: [id])
  notes       String?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  items       ChecklistResponseItem[]
}

model ChecklistResponseItem {
  id         String            @id @default(cuid())
  responseId String
  response   ChecklistResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  itemId     String
  item       ChecklistItem     @relation(fields: [itemId], references: [id])
  checked    Boolean           @default(false)
  notes      String?

  @@unique([responseId, itemId])
}

